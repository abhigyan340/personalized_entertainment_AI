# ── TMDB API credentials ─────────────────────────────────────────────────────
# Get these from https://www.themoviedb.org/settings/api
# TMDB_READ_ACCESS_TOKEN is required for all TMDB API v4 calls.
# TMDB_API_KEY is the v3 key (currently unused but kept for reference).
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# ── FastAPI ML service ────────────────────────────────────────────────────────
# Port the Python FastAPI service listens on.
# The Node.js server must be told the same value via ML_SERVICE_URL.
FASTAPI_PORT=8000

# ── Node.js server ────────────────────────────────────────────────────────────
# Port the Node.js API + frontend server listens on.
PORT=3000

# URL the Node.js server uses to reach the FastAPI service.
ML_SERVICE_URL=http://127.0.0.1:8000
